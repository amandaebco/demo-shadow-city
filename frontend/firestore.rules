rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Track B frontend reads scenario state, ticks, and metrics/summary in real time.
    // All writes are performed by backend service accounts (sc-orchestrator, sc-sim-worker).
    match /scenarios/{scenarioId} {
      allow read: if true;
      allow write: if false;
    }
    match /scenarios/{scenarioId}/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

