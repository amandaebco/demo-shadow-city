{
  "firestore": [
    {
      "database": "shadow-city",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "site": "shadow-city",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/v1/**",
        "run": {
          "serviceId": "orchestrator",
          "region": "asia-southeast2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
