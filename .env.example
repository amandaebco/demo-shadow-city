# Shared configuration for Shadow City. Copy to .env and adjust if needed.
# All Google Cloud resources live in this single project (see AGENTS.md).
GCP_PROJECT_ID=ebc-cloud-dev-03
GCP_REGION=asia-southeast2
FIRESTORE_DATABASE=shadow-city

# Gemini on Vertex AI (System Two, and System One until Layer 5).
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# system-one decider: "rule" (CONTRACT.md §4.4 mock) or "gemini" (Layer 1-4).
SYSTEM_ONE_DECIDER=gemini

# Company-wide Cloud Build project for CI (see AGENTS.md, "Exception — CI builds").
CI_PROJECT_ID=ebc-source-code
CI_REGION=asia-southeast2

# BigQuery dataset for the decision log (CONTRACT.md §6).
BIGQUERY_DATASET=shadow_city
